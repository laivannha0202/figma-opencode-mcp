{
  "name": "figma-opencode-mcp",
  "version": "0.2.1",
  "description": "Local-first MCP server for OpenCode/Codex that connects AI coding agents to the currently open Figma file through a local plugin bridge",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "figma-opencode-mcp": "bin/figma-opencode-mcp.js"
  },
  "files": [
    "bin",
    "dist",
    "plugin",
    "docs",
    "examples",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "dev": "tsx src/index.ts",
    "build": "tsc -p tsconfig.json",
    "build:plugin": "tsc -p plugin/tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "verify": "npm run typecheck && npm run build && npm run build:plugin",
    "prepack": "npm run build && npm run build:plugin",
    "pack:dry": "npm pack --dry-run",
    "format": "prettier --write \"**/*.{ts,js,json,md,yml,yaml}\"",
    "format:check": "prettier --check \"**/*.{ts,js,json,md,yml,yaml}\""
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "ws": "^8.21.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@figma/plugin-typings": "^1.128.0",
    "@types/node": "^22.0.0",
    "@types/ws": "^8.18.0",
    "prettier": "^3.5.0",
    "tsx": "^4.22.4",
    "typescript": "^5.8.0"
  },
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "mcp",
    "figma",
    "opencode",
    "codex",
    "plugin-bridge",
    "local-first"
  ],
  "license": "MIT"
}
